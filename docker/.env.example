# SO-101 training container — secrets (NEVER commit the real .env)
# Used via `docker run --env-file docker/.env` / `apptainer run --env-file docker/.env`

# WandB (training metrics). Alternative: WANDB_MODE=offline
WANDB_API_KEY=

# GitHub personal-access-token — needed only while the repo or the
# third_party/skrl submodule is private (runtime clone uses it)
GITHUB_TOKEN=

# Uncomment to keep wandb runs local to the container
# WANDB_MODE=offline
