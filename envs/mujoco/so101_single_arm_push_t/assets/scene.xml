<mujoco model="so101_single_arm_push_t_scene">
  <compiler angle="radian" meshdir="../../../../robots/so101/meshes" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <include file="../../../../robots/so101/so101_follower.xml"/>

  <statistic center="0.35 0 0.5" extent="1.2" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_surface" rgba="0.85 0.75 0.6 1"/>
    <material name="t_block_mat" rgba="0.2 0.45 0.85 1"/>
    <material name="target_outline_mat" rgba="0.1 0.9 0.1 0.5"/>
  </asset>

  <worldbody>
    <light name="top_light"   pos="0.35 0.0 2.5"  dir="0 0 -1"        diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" castshadow="true"/>
    <light name="front_light" pos="0.5 -1.2 1.5"  dir="-0.1 0.6 -0.8" diffuse="0.5 0.5 0.5"/>

    <!-- Floor -->
    <geom name="floor" type="plane" size="3 3 0.01" material="groundplane" condim="3"/>

    <!-- Table -->
    <geom name="table_top"     type="box"      size="0.40 0.35 0.02" pos="0.35 0.0 0.80"  material="table_surface" condim="3"/>
    <geom name="table_leg_fl"  type="cylinder" size="0.02 0.40"      pos="0.70 0.30 0.40"/>
    <geom name="table_leg_fr"  type="cylinder" size="0.02 0.40"      pos="0.70 -0.30 0.40"/>
    <geom name="table_leg_bl"  type="cylinder" size="0.02 0.40"      pos="0.02 0.30 0.40"/>
    <geom name="table_leg_br"  type="cylinder" size="0.02 0.40"      pos="0.02 -0.30 0.40"/>

    <!-- T-shaped push block: crossbar (12 cm x 4 cm) + stem (8 cm x 4 cm),
         2.5 cm thick. Body origin at the composite area centroid; MuJoCo
         derives the matching composite inertial from the two box geoms
         (uniform density, total mass ~0.16 kg). -->
    <body name="t_block" pos="0.40 0.0 0.8325">
      <freejoint name="t_block_joint"/>
      <!-- crossbar: local x in [-0.036, 0.004], y in [-0.06, 0.06] -->
      <geom name="t_block_bar" type="box" size="0.020 0.060 0.0125" pos="-0.016 0 0"
            material="t_block_mat" condim="4" friction="1.0 0.005 0.0001"/>
      <!-- stem: local x in [0.004, 0.044], y in [-0.02, 0.02] -->
      <geom name="t_block_stem" type="box" size="0.020 0.020 0.0125" pos="0.024 0 0"
            material="t_block_mat" condim="4" friction="1.0 0.005 0.0001"/>
    </body>

    <!-- Target T outline on the table (visual-only green strips tracing the
         block footprint contour; block slides over it). Fixed pose in front
         of the arm. -->
    <body name="target_outline" pos="0.45 0.0 0.821">
      <geom name="target_bar_back"  type="box" size="0.0015 0.0615 0.001" pos="-0.036 0 0"
            material="target_outline_mat" contype="0" conaffinity="0"/>
      <geom name="target_bar_side_n" type="box" size="0.0215 0.0015 0.001" pos="-0.016 -0.06 0"
            material="target_outline_mat" contype="0" conaffinity="0"/>
      <geom name="target_bar_side_p" type="box" size="0.0215 0.0015 0.001" pos="-0.016  0.06 0"
            material="target_outline_mat" contype="0" conaffinity="0"/>
      <geom name="target_bar_inner_n" type="box" size="0.0015 0.0415 0.001" pos="0.004 -0.04 0"
            material="target_outline_mat" contype="0" conaffinity="0"/>
      <geom name="target_bar_inner_p" type="box" size="0.0015 0.0415 0.001" pos="0.004  0.04 0"
            material="target_outline_mat" contype="0" conaffinity="0"/>
      <geom name="target_stem_side_n" type="box" size="0.021 0.0015 0.001" pos="0.024 -0.02 0"
            material="target_outline_mat" contype="0" conaffinity="0"/>
      <geom name="target_stem_side_p" type="box" size="0.021 0.0015 0.001" pos="0.024  0.02 0"
            material="target_outline_mat" contype="0" conaffinity="0"/>
      <geom name="target_stem_tip"  type="box" size="0.0015 0.023 0.001" pos="0.044 0 0"
            material="target_outline_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- World-fixed cameras: positions/euler overridden at runtime from CameraConfig.
         Global cameras covering the workspace. -->
    <camera name="overhead" pos="0.41 0.05 1.35" euler="0 0 90" fovy="65"/>
    <camera name="front"    pos="0.40 -0.95 1.05" euler="75 0 0" fovy="60"/>
  </worldbody>

    <keyframe>
      <key name="home"
        qpos="0 -0.5 0.8 0.4 0 0  0.36 0.12 0.8325 1 0 0 0"
        ctrl="0 -0.5 0.8 0.4 0 1.5"/>
    </keyframe>
</mujoco>
