<mujoco model="so101_single_arm_cube_push_bridge_scene">
  <compiler angle="radian" meshdir="../../../../robots/so101/meshes" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <include file="../../../../robots/so101/so101_follower.xml"/>

  <statistic center="0.40 0 0.55" extent="1.2" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_surface" rgba="0.85 0.75 0.6 1"/>
    <material name="bridge_surface" rgba="0.75 0.65 0.5 1"/>
    <material name="goal_marker_mat" rgba="0.1 0.9 0.1 0.35"/>
  </asset>

  <worldbody>
    <light name="top_light"   pos="0.35 0.0 2.5"  dir="0 0 -1"        diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" castshadow="true"/>
    <light name="front_light" pos="0.5 -1.2 1.5"  dir="-0.1 0.6 -0.8" diffuse="0.5 0.5 0.5"/>

    <!-- Floor -->
    <geom name="floor" type="plane" size="3 3 0.01" material="groundplane" condim="3"/>

    <!-- Near table section (arm sits on its far edge), x in [-0.05, 0.42] -->
    <geom name="table_top_near" type="box" size="0.235 0.35 0.02" pos="0.185 0.0 0.80" material="table_surface" condim="3"/>
    <geom name="table_leg_nfl"  type="cylinder" size="0.02 0.40"      pos="0.38 0.30 0.40"/>
    <geom name="table_leg_nfr"  type="cylinder" size="0.02 0.40"      pos="0.38 -0.30 0.40"/>
    <geom name="table_leg_nbl"  type="cylinder" size="0.02 0.40"      pos="0.02 0.30 0.40"/>
    <geom name="table_leg_nbr"  type="cylinder" size="0.02 0.40"      pos="0.02 -0.30 0.40"/>

    <!-- Far table section, x in [0.55, 0.75]; 13 cm gap between the two tops -->
    <geom name="table_top_far" type="box" size="0.10 0.35 0.02" pos="0.65 0.0 0.80" material="table_surface" condim="3"/>
    <geom name="table_leg_ffl" type="cylinder" size="0.02 0.40"      pos="0.72 0.30 0.40"/>
    <geom name="table_leg_ffr" type="cylinder" size="0.02 0.40"      pos="0.72 -0.30 0.40"/>
    <geom name="table_leg_fbl" type="cylinder" size="0.02 0.40"      pos="0.58 0.30 0.40"/>
    <geom name="table_leg_fbr" type="cylinder" size="0.02 0.40"      pos="0.58 -0.30 0.40"/>

    <!-- Narrow bridge spanning the gap, x in [0.42, 0.55], y in [-0.035, 0.035],
         top flush with the tables (z = 0.82) -->
    <geom name="bridge_span" type="box" size="0.065 0.035 0.02" pos="0.485 0.0 0.80" material="bridge_surface" condim="3"/>
    <geom name="bridge_leg_f" type="cylinder" size="0.008 0.39" pos="0.53 0.0 0.39"/>
    <geom name="bridge_leg_b" type="cylinder" size="0.008 0.39" pos="0.44 0.0 0.39"/>

    <!-- Manipulation object: 4.5 cm red cube with freejoint, starts on near table -->
    <body name="cube" pos="0.36 0.0 0.844">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.0225 0.0225 0.0225" mass="0.08"
            rgba="0.85 0.2 0.2 1" condim="4" friction="1.0 0.005 0.0001"/>
    </body>

    <!-- Goal patch (visual only): flat green disc on the FAR table across the bridge -->
    <body name="goal_marker" pos="0.64 0.0 0.8225">
      <geom name="goal_geom" type="cylinder" size="0.07 0.0025"
            material="goal_marker_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- World-fixed cameras: positions/euler overridden at runtime from CameraConfig -->
    <!-- Global cameras covering the entire workspace (positions/euler overridable
         at runtime via the matching CameraConfig entries in env.py) -->
    <camera name="overhead_cam" pos="0.30 0.0 1.50" euler="0 0 90" fovy="65"/>
    <camera name="front_cam"    pos="0.35 -1.05 1.05" euler="75 0 0" fovy="65"/>
  </worldbody>

  <keyframe>
    <key name="home"
      qpos="0 -0.5 0.8 0.4 0 0  0.36 0.0 0.844 1 0 0 0"
      ctrl="0 -0.5 0.8 0.4 0 0"/>
  </keyframe>
</mujoco>
